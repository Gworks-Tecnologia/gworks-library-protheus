#include 'totvs.ch'
#include 'tlpp-core.th'

#define NPOS_CLASSE 01
#define NPOS_CONTA  02
#define NPOS_DESC   03
#define NPOS_NORMAL 04

#define CRLF chr(13)+chr(10)
#define CRLF2 CRLF+CRLF

Static aDados__ as array
Static cRegistered__ as character
Static cNormalInvalid__ as character
Static cAutoGrLog__ as character
Static oModelCtb__ as object

using namespace Gworks.Library.Classes
using namespace Gworks.Library.Utils

namespace Gworks.Library.Functions

/*/{Protheus.doc} U_ImportarPC // Gworks.Library.Functions.U_ImportarPC
Função para importar arquivo csv de Plano de Contas, conforme layout:
    [01] - CT1_CLASSE TIPO:C - Classe da Conta
    [02] - CT1_CONTA  TIPO:C - Código da Conta Contábil
    [03] - CT1_DESC01 TIPO:C - Descrição da Conta
    [04] - CT1_NORMAL TIPO:C - Natureza da Conta (1 - Devedora / 2 - Credora)

@type function
@version 12.1.2410
@author TOTVS
@since 8/16/2026
/*/
User Function ImportarPLContas() // GWORKS.LIBRARY.FUNCTIONS.IMPORTARPC

    Local lResult as logical

    Private cTarget_ := '' as character
    Private oError_ := GwError():New() as object
    Private oLog_ := GwConsoleLog():New() as object
    Private jMessage_ := U_GwGetMessage() as json
    Private lProduction_ := empty(GetSrvProfString("SpecialKey","")) as logical
    Private lBlind_ := (isBlind() .or. type('CEMPANT') == 'U' ) as logical

    if lBlind_
        UserException("GWORKS.LIBRARY.FUNCTIONS.U_IMPORTARPC - Invalid rpc call...")
    endif

    // Recicla aDados__ de processamentos anteriores
    if !empty(aDados__)
        fwFreeVar(aDados__)
    endif

    aDados__ := {}
    cRegistered__ := ''
    cNormalInvalid__ := ''
    cAutoGrLog__ := ''

    try

        if( ( empty(cTarget_) .and. !fGetFile() ) .or. !file(cTarget_) )

            jMessage_['cState'] := "WARNING"
            jMessage_['cError'] := "Arquivo inválido ou não selecionado!"
            jMessage_['cSuggestion'] := "Selecione um arquivo válido e tente novamente."
            jMessage_['cTitle'] := "Atenção!"
            jMessage_['lError'] := .F.
            jMessage_['cDetails'] := ""

            U_GwSetMessage(oError_, oLog_, jMessage_)

            return

        endif

        processa({|| lResult := fProcess()}, "Importando arquivo...", "Aguarde...")
        if!( lResult )
            return
        endif

    catch _varError

        if!( oError_:lError )

            jMessage_['cState'] := "FAULT"
            jMessage_['cError'] := "Falha inesperada!"
            jMessage_['cSuggestion'] := "Favor contactar o suporte técnico."
            jMessage_['cTitle'] := "Falha!"
            jMessage_['lError'] := .T.
            jMessage_['cDetails'] := ;
                                    "Erro:" + _varError:Description +CRLF2+;
                                    "Stack:" + _varError:errorStack

            U_GwSetMessage(oError_, oLog_, jMessage_)

        endif

    endtry

    if lResult
        fWAlertSuccess("Arquivo processado com sucesso.", "Sucesso!")
    endif

    oError_:Clear()
    oLog_:Clear()

Return

/*/{Protheus.doc} fGetFile
Obtém o arquivo a ser importado.
@type function
@version 12.1.2410
@author TOTVS
@since 8/16/2026
@return logical, Retorna .T. (true) para indicar sucesso.
/*/
Static Function fGetFile as logical

    Local lResult := .T. as logical

    do case
    case cValToChar(getRemoteType()) $ '0,1'
        cTarget_ := tFileDialog("Arquivos CSV (*.csv)","Seleção de Arquivo",,'C:\Temp\',.F.,)

    case cValToChar(getRemoteType()) == '2'
        cTarget_ := tFileDialog("Arquivos CSV (*.csv)","Seleção de Arquivo",,'/temp/',.F.)

    otherwise
        lResult := .F.

    endcase

Return lResult

/*/{Protheus.doc} fProcess
Função para processamento da importação do arquivo.
@type function
@version 12.1.2410
@author TOTVS
@since 8/16/2026
@return logical, Retorna .T. (true) para indicar sucesso e .F. (false) em caso de falhas.
/*/
Static Function fProcess as logical

    Local lResult as logical
    Local nI as numeric
    Local nHDL as numeric
    Local nLinha as numeric
    Local cBuffer as character
    Local aBuffer as array

    nHDL := FT_FUSE(cTarget_)
    if nHDL < 0

        jMessage_['cState'] := "FAULT"
        jMessage_['cError'] := "Falha ao abrir arquivo!"
        jMessage_['cSuggestion'] := "Verifique o arquivo selecionado e tente novamente."
        jMessage_['cTitle'] := "Atenção!"
        jMessage_['lError'] := .T.
        jMessage_['cDetails'] := ""

        U_GwSetMessage(oError_, oLog_, jMessage_)

        return .F.

    endif

    while .not. FT_FEOF()

        cBuffer := FT_FREADLN()
        aBuffer := strToKArr2(cBuffer,';',.T.)

        if empty(aBuffer)
            FT_FSKIP()
            Loop // ignora linhas vazias
        endif

        nLinha++

        if( nLinha == 1 )
            FT_FSKIP()
            loop // ignora cabeçalho (primeira linha com conteúdo)
        else
            if!( fReadData(@aBuffer, allTrim(str(nLinha))) )
                exit
            endif
        endif

        FT_FSKIP()

    enddo

    FT_FUSE()

    if empty(aDados__)

        jMessage_['cState'] := "WARNING"
        jMessage_['cError'] := "Nenhum dado encontrado no arquivo!"
        jMessage_['cSuggestion'] := "Verifique se o arquivo contém linhas de dados além do cabeçalho."
        jMessage_['cTitle'] := "Atenção!"
        jMessage_['lError'] := .F.
        jMessage_['cDetails'] := ""

        U_GwSetMessage(oError_, oLog_, jMessage_)

        return .F.

    endif

    procregua(len(aDados__))
    cRegistered__ := ''
    cNormalInvalid__ := ''
    cAutoGrLog__ := ''
    for nI := 1 To Len(aDados__)
        incproc()
        fCadastrarConta( aDados__[nI][1], aDados__[nI][2] )
    next

    lResult := empty(cAutoGrLog__)

    if !empty(cRegistered__)

        jMessage_['cState'] := "WARNING"
        jMessage_['cError'] := "Contas já cadastradas!"
        jMessage_['cSuggestion'] := "Não é possível atualizar dados de Contas já cadastradas."
        jMessage_['cTitle'] := "Atenção!"
        jMessage_['lError'] := .F.
        jMessage_['cDetails'] := cRegistered__

        U_GwSetMessage(oError_, oLog_, jMessage_)

    endif

    if !empty(cNormalInvalid__)

        jMessage_['cState'] := "WARNING"
        jMessage_['cError'] := "Contas com Natureza (Normal) inválida!"
        jMessage_['cSuggestion'] := "Favor verificar as Contas listadas a seguir. Valores aceitos: 1 - Devedora / 2 - Credora."
        jMessage_['cTitle'] := "Atenção!"
        jMessage_['lError'] := .F.
        jMessage_['cDetails'] := "NATUREZA (NORMAL) INVÁLIDA: " + CRLF + cNormalInvalid__

        U_GwSetMessage(oError_, oLog_, jMessage_)

    endif

    if !empty(cAutoGrLog__)

        jMessage_['cState'] := "FAULT"
        jMessage_['cError'] := "Falha ao efetivar importação via ExecAuto!"
        jMessage_['cSuggestion'] := "Corrija os erros criticados no log a seguir e tente novamente."
        jMessage_['cTitle'] := "Atenção!"
        jMessage_['lError'] := .F.
        jMessage_['cDetails'] := "EXECAUTO ERRO LIST: " + CRLF + cAutoGrLog__

        U_GwSetMessage(oError_, oLog_, jMessage_)

    endif

Return lResult

/*/{Protheus.doc} fReadData
Obtém os dados de uma determinada linha do arquivo e os correlaciona com a estrutura Json presente em jData__.
@type function
@version 12.1.2410
@author TOTVS
@since 8/16/2026
@param aLinha, array, Linha a ser processada.
@param cLinha, character, Número da linha correspondente.
/*/
Static Function fReadData( aLinha as array, cLinha as character )

    Local lResult := .T. as logical
    Local nCol as numeric // coluna
    Local xValue as variant

    if empty(aLinha)

        jMessage_['cState'] := "FAULT"
        jMessage_['cError'] := "Linha "+ ( '"'+cLinha+'"' ) +" vazia..."
        jMessage_['cSuggestion'] := "Verifique o arquivo e tente novamente."
        jMessage_['cTitle'] := "Atenção!"
        jMessage_['lError'] := .T.
        jMessage_['cDetails'] := ;
                                "[01] CT1_CLASSE - Classe da Conta" + CRLF +;
                                "[02] CT1_CONTA  - Código da Conta Contábil" + CRLF +;
                                "[03] CT1_DESC01 - Descrição da Conta" + CRLF +;
                                "[04] CT1_NORMAL - Natureza da Conta (1 - Devedora / 2 - Credora)"

        U_GwSetMessage(oError_, oLog_, jMessage_)

        return .F.

    endif

    for nCol:=1 to len(aLinha)

        xValue := aLinha[nCol]

        if empty(xValue)

            xValue := " "

        else

            do case
                case nCol == NPOS_CLASSE ; xValue := upper(LEFT(fFormatCodigo(xValue),1))
                case nCol == NPOS_CONTA  ; xValue := upper(LEFT(xValue,20))
                case nCol == NPOS_DESC   ; xValue := upper(allTrim(LEFT(xValue,40)))
                case nCol == NPOS_NORMAL ; xValue := upper(allTrim(LEFT(xValue,1)))
            endcase

        endif

        aLinha[nCol] := xValue // devolve valor tratado para o array aLinha

    next

    if !fValidNormal( @aLinha )
        cNormalInvalid__ +=;
                        "CLASSE: " + aLinha[ NPOS_CLASSE ] + ' - ' +;
                        "CONTA: " + aLinha[ NPOS_CONTA ] + ' - ' +;
                        "DESCRICAO: " + aLinha[ NPOS_DESC ] + ' - ' +;
                        "NATUREZA INFORMADA: " + aLinha[ NPOS_NORMAL ] + CRLF
    endif

    aAdd( aDados__, { aLinha, cLinha } )

Return lResult

/*/{Protheus.doc} fCadastrarConta
Função auxiliar para gravação da Conta Contábil na tabela CT1 do banco de dados.
@type function
@version 12.1.2410
@author TOTVS
@since 8/16/2026
@param aLinha, array, Linha de dados a serem gravados.
@param cLinha, character, Linha a ser gravada em formato de texto.
/*/
Static Function fCadastrarConta( aLinha as array, cLinha as character ) as logical

    Local oModelCT1 as object
    Local aErro as array
    Local cErro as character
    Local nX as numeric

    // Valida se a Conta (CT1_CONTA) informada ja existe na tabela CT1
    CT1->( dbSelectArea("CT1"), dbSetOrder(1), dbGoTop() )
    if( CT1->( msSeek( xFilial("CT1") + aLinha[ NPOS_CONTA ] ) ) )
        cRegistered__ += ;
                        "CONTA: " + aLinha[ NPOS_CONTA ] + ' - ' +;
                        "DESCRICAO: "+ aLinha[ NPOS_DESC ] + CRLF
        return .T.
    endif

    // CTBA020 foi convertido para MVC - inclusão via FWLoadModel (MSExecAuto não é mais suportado)
    // Modelo carregado uma unica vez e reaproveitado, conforme exemplo oficial TOTVS
    if oModelCtb__ == Nil
        oModelCtb__ := FWLoadModel('CTBA020')
    endif

    oModelCtb__:SetOperation(3) // 3 - Inclusão
    oModelCtb__:Activate()

    oModelCT1 := oModelCtb__:GetModel('CT1MASTER')
    oModelCT1:LoadValue('CT1_CONTA' , aLinha[ NPOS_CONTA ] )
    oModelCT1:LoadValue('CT1_DESC01', aLinha[ NPOS_DESC ]  )
    oModelCT1:LoadValue('CT1_CLASSE', aLinha[ NPOS_CLASSE ])
    oModelCT1:LoadValue('CT1_NORMAL', aLinha[ NPOS_NORMAL ])

    if!( oModelCtb__:VldData() .and. oModelCtb__:CommitData() )

        aErro := oModelCtb__:GetErrorMessage()
        cErro := ""
        for nX := 1 to len(aErro)
            if !empty(aErro[nX])
                cErro += allTrim(aErro[nX]) + CRLF
            endif
        next nX

        if!empty(cAutoGrLog__)
            cAutoGrLog__ += CRLF // se ja existe um log de erro, adiciona uma quebra de linha
        endif

        cAutoGrLog__ += "CTBA020/Linha:" + cLinha + CRLF + cErro // concatena o log de erro com o erro capturado do model

    endif

    oModelCtb__:DeActivate()

Return .T.

/*/{Protheus.doc} fValidNormal
Valida se a Natureza (CT1_NORMAL) da Conta informada é válida (1 - Devedora / 2 - Credora).
@type function
@version 12.1.2410
@author TOTVS
@since 8/16/2026
@param aLinha, array, Linha de dados.
@return logical, Retorna .T. (true) para natureza válida ou .F. (false) para natureza inválida.
/*/
Static Function fValidNormal( aLinha as array ) as logical

Return( aLinha[ NPOS_NORMAL ] $ "1;2" )

/*/{Protheus.doc} fFormatCodigo
Função auxiliar para formatar o código informado, removendo caracteres especiais.
@type function
@version 12.1.2410
@author TOTVS
@since 8/16/2026
@param cCodigo, character, Código a ser formatado.
@return character, Código formatado.
/*/
Static Function fFormatCodigo( cCodigo as character ) as character

    cCodigo := allTrim(cCodigo)
    cCodigo := replace(cCodigo, '.', '')
    cCodigo := replace(cCodigo, '-', '')
    cCodigo := replace(cCodigo, '/', '')
    cCodigo := replace(cCodigo, '\', '')

Return cCodigo

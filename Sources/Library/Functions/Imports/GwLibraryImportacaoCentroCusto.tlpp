#include 'totvs.ch'
#include 'tlpp-core.th'

#define NPOS_CODIGO 01
#define NPOS_DESC   02
#define NPOS_CLASSE 03
#define NPOS_CCSUP  04

#define CRLF chr(13)+chr(10)
#define CRLF2 CRLF+CRLF

Static aDados__ as array
Static cRegistered__ as character
Static cClasseInvalid__ as character
Static cAutoGrLog__ as character

using namespace Gworks.Library.Classes
using namespace Gworks.Library.Utils

namespace Gworks.Library.Functions

/*/{Protheus.doc} ImportarCCusto // Gworks.Library.Functions.U_ImportarCCusto
Função para importar arquivo csv de Centro de Custo, conforme layout:
    [01] - CTT_CUSTO  TIPO:C - Codigo do Centro de Custo
    [02] - CTT_DESC01 TIPO:C - Descricao do Centro de Custo
    [03] - CTT_CLASSE TIPO:C - Classe (1 - Sintetico / 2 - Analitico)
    [04] - CTT_CCSUP  TIPO:C - Codigo do Centro de Custo Superior (Pai) - Opcional

@type function
@version 12.1.2410
@author TOTVS
@since 7/3/2025
/*/
User Function ImportarCCusto()

    Local lResult as logical

    Private cTarget_ := '' as character
    Private oError_ := GwError():New() as object
    Private oLog_ := GwConsoleLog():New() as object
    Private jMessage_ := U_GwGetMessage() as json
    Private lProduction_ := empty(GetSrvProfString("SpecialKey","")) as logical
    Private lBlind_ := (isBlind() .or. type('CEMPANT') == 'U' ) as logical

    if lBlind_
        UserException("GWORKS.LIBRARY.FUNCTIONS.U_IMPORTARCCUSTO - Invalid rpc call...")
    endif

    // Recicla aDados__ de processamentos anteriores
    if !empty(aDados__)
        fwFreeVar(aDados__)
    endif

    aDados__ := {}
    cRegistered__ := ''
    cClasseInvalid__ := ''
    cAutoGrLog__ := ''

    try

        if( ( empty(cTarget_) .and. !fGetFile() ) .or. !file(cTarget_) )

            jMessage_['cState'] := "WARNING"
            jMessage_['cError'] := "Arquivo inválido ou não selecionado!"
            jMessage_['cSuggestion'] := "Selecione um arquivo válido e tente novamente."
            jMessage_['cTitle'] := "Atenção!"
            jMessage_['lError'] := .F.
            jMessage_['cDetails'] := ""

            U_GwSetMessage(oError_, oLog_, jMessage_)

            return

        endif

        processa({|| lResult := fProcess()}, "Importando arquivo...", "Aguarde...")
        if!( lResult )
            return
        endif

    catch _varError

        if!( oError_:lError )

            jMessage_['cState'] := "FAULT"
            jMessage_['cError'] := "Falha inesperada!"
            jMessage_['cSuggestion'] := "Favor contactar o suporte técnico."
            jMessage_['cTitle'] := "Falha!"
            jMessage_['lError'] := .T.
            jMessage_['cDetails'] := ;
                                    "Erro:" + _varError:Description +CRLF2+;
                                    "Stack:" + _varError:errorStack

            U_GwSetMessage(oError_, oLog_, jMessage_)

        endif

    endtry

    if lResult
        fWAlertSuccess("Arquivo processado com sucesso.", "Sucesso!")
    endif

    oError_:Clear()
    oLog_:Clear()

Return

/*/{Protheus.doc} fGetFile
Obtem o arquivo a ser importado.
@type function
@version 12.1.2410
@author TOTVS
@since 5/13/2025
@return logical, Retorna .T. (true) para indicar sucesso.
/*/
Static Function fGetFile as logical

    Local lResult := .T. as logical

    do case
    case cValToChar(getRemoteType()) $ '0,1'
        cTarget_ := tFileDialog("Arquivos CSV (*.csv)","Seleção de Arquivo",,'C:\Temp\',.F.,)

    case cValToChar(getRemoteType()) == '2'
        cTarget_ := tFileDialog("Arquivos CSV (*.csv)","Seleção de Arquivo",,'l:/tmp/',.F.)

    otherwise
        lResult := .F.

    endcase

Return lResult

/*/{Protheus.doc} fProcess
Função para processamento da importacao do arquivo.
@type function
@version 12.1.2410
@author TOTVS
@since 5/13/2025
@return logical, Retorna .T. (true) para indicar sucesso e .F. (false) em caso de falhas.
/*/
Static Function fProcess as logical

    Local lResult as logical
    Local lData as logical
    Local nI as numeric
    Local nHDL as numeric
    Local nLinha as numeric
    Local cBuffer as character
    Local aBuffer as array

    nHDL := FT_FUSE(cTarget_)
    if nHDL < 0

        jMessage_['cState'] := "FAULT"
        jMessage_['cError'] := "Falha ao abrir arquivo!"
        jMessage_['cSuggestion'] := "Verifique o arquivo selecionado e tente novamente."
        jMessage_['cTitle'] := "Atenção!"
        jMessage_['lError'] := .T.
        jMessage_['cDetails'] := ""

        U_GwSetMessage(oError_, oLog_, jMessage_)

        return .F.

    endif

    while .not. FT_FEOF()

        nLinha++
        cBuffer := FT_FREADLN()
        aBuffer := strToKArr2(cBuffer,';',.T.)

        if empty(aBuffer)
            FT_FSKIP()
            Loop // ignora linhas vazias
        endif

        if( nLinha == 1 )
            FT_FSKIP()
            loop // ignora cabeçalho (linha 1)
        else
            if!( lData := fReadData(@aBuffer, allTrim(str(nLinha))) )
                exit
            endif
        endif

        FT_FSKIP()

    enddo

    if!( lData )
        return .F.
    endif

    FT_FUSE()

    procregua(len(aDados__))
    cRegistered__ := ''
    cClasseInvalid__ := ''
    cAutoGrLog__ := ''
    for nI := 1 To Len(aDados__)
        incproc()
        if!( lResult := fCadastrarCentroCusto( aDados__[nI], allTrim(str(nI)) ) )
            exit
        endif
    next

    if !empty(cRegistered__)

        jMessage_['cState'] := "WARNING"
        jMessage_['cError'] := "Centros de Custo já cadastrados!"
        jMessage_['cSuggestion'] := "Não é possível atualizar dados de Centros de Custo já cadastrados."
        jMessage_['cTitle'] := "Atenção!"
        jMessage_['lError'] := .F.
        jMessage_['cDetails'] := cRegistered__

        U_GwSetMessage(oError_, oLog_, jMessage_)

    endif

    if !empty(cClasseInvalid__)

        jMessage_['cState'] := "WARNING"
        jMessage_['cError'] := "Centros de Custo com Classe (Tipo) inválida!"
        jMessage_['cSuggestion'] := "Favor verificar os Centros de Custo listados a seguir. Valores aceitos: 1 - Sintético / 2 - Analítico."
        jMessage_['cTitle'] := "Atenção!"
        jMessage_['lError'] := .F.
        jMessage_['cDetails'] := "CLASSE (TIPO) INVÁLIDA: " + CRLF + cClasseInvalid__

        U_GwSetMessage(oError_, oLog_, jMessage_)

    endif

    if !empty(cAutoGrLog__)

        jMessage_['cState'] := "FAULT"
        jMessage_['cError'] := "Falha ao efetivar importação via ExecAuto!"
        jMessage_['cSuggestion'] := "Corrija os erros criticados no log a seguir e tente novamente."
        jMessage_['cTitle'] := "Atenção!"
        jMessage_['lError'] := .F.
        jMessage_['cDetails'] := "EXECAUTO ERRO LIST: " + CRLF + cAutoGrLog__

        U_GwSetMessage(oError_, oLog_, jMessage_)

    endif

Return lResult

/*/{Protheus.doc} fReadData
Obtem os dados de uma determinada linha do arquivo e os correlaciona com a estrutura Json presente em jData__.
@type function
@version 12.1.2410
@author TOTVS
@since 5/14/2025
@param aLinha, array, Linha a ser processada.
@param cLinha, character, Número da linha correspondente.
/*/
Static Function fReadData( aLinha as array, cLinha as character )

    Local lResult := .T. as logical
    Local nCol as numeric // coluna
    Local xValue as variant

    if empty(aLinha)

        jMessage_['cState'] := "FAULT"
        jMessage_['cError'] := "Linha "+ ( '"'+cLinha+'"' ) +" vazia..."
        jMessage_['cSuggestion'] := "Verifique o arquivo e tente novamente."
        jMessage_['cTitle'] := "Atenção!"
        jMessage_['lError'] := .T.
        jMessage_['cDetails'] := cLayout__

        U_GwSetMessage(oError_, oLog_, jMessage_)

        return .F.

    endif

    for nCol:=1 to len(aLinha)

        xValue := aLinha[nCol]

        if empty(xValue)

            xValue := " "

        else

            do case
                case nCol == NPOS_CODIGO ; xValue := upper(fFormatCodigo(LEFT(xValue,9)))
                case nCol == NPOS_DESC   ; xValue := upper(allTrim(LEFT(xValue,40)))
                case nCol == NPOS_CLASSE ; xValue := allTrim(LEFT(xValue,1))
                case nCol == NPOS_CCSUP  ; xValue := upper(fFormatCodigo(LEFT(xValue,9)))
            endcase

        endif

        aLinha[nCol] := xValue // devolve valor tratado para o array aLinha

    next

    if !fValidClasse( @aLinha )
        cClasseInvalid__ +=;
                        "CODIGO: " + aLinha[ NPOS_CODIGO ] + ' - ' +;
                        "CENTRO DE CUSTO: " + aLinha[ NPOS_DESC ] + ' - ' +;
                        "TIPO INFORMADO: " + aLinha[ NPOS_CLASSE ] + CRLF
    endif

    aAdd( aDados__, aLinha )

Return lResult

/*/{Protheus.doc} fCadastrarCentroCusto
Função auxiliar para gravação do Centro de Custo na tabela CTT do banco de dados.
@type function
@version 12.1.2410
@author TOTVS
@since 5/13/2025
@param aLinha, array, Linha de dados a serem gravados.
@param cLinha, character, Linha a ser gravada em formato de texto.
/*/
Static Function fCadastrarCentroCusto( aLinha as array, cLinha as character ) as logical

    Local aAuto as array

    // Valida se o Centro de Custo (CTT_CUSTO) informado ja existe na tabela CTT
    CTT->( dbSelectArea("CTT"), dbSetOrder(1), dbGoTop() )
    if( CTT->( msSeek( xFilial("CTT") + aLinha[ NPOS_CODIGO ] ) ) )
        cRegistered__ += ;
                        "CODIGO: " + aLinha[ NPOS_CODIGO ] + ' - ' +;
                        "CENTRO DE CUSTO: "+ aLinha[ NPOS_DESC ] + CRLF
        return .T.
    endif

    aAuto := {;
        {"CTT_CUSTO" , aLinha[ NPOS_CODIGO ], Nil},;
        {"CTT_DESC01", aLinha[ NPOS_DESC ]  , Nil},;
        {"CTT_CLASSE", aLinha[ NPOS_CLASSE ], Nil},;
        {"CTT_CCSUP" , aLinha[ NPOS_CCSUP ] , Nil} ;
    }

    BEGIN TRANSACTION

        Private lMsErroAuto as logical
        Private lMsHelpAuto as logical
        Private lAutoErrNoFile as logical

        oError_:SetExecAutoVariables()

        msExecAuto({|x,y| CTBA030(x,y)},aAuto,3)

        if( lMsErroAuto )
            oError_:lError := .T.
            disarmTransaction()
            CTT->(rollBackSx8())
            break

        else
            ConfirmSx8()
        endif

    END TRANSACTION

    if( oError_:lError )

        oError_:SetAutoGRLogFromExecAuto("CTBA030/Linha:" + cLinha) // captura erro do executo

        if!empty(cAutoGrLog__)
            cAutoGrLog__ += CRLF // se ja existe um log de erro, adiciona uma quebra de linha
        endif

        cAutoGrLog__ += oError_:cAutoGrLog // concatena o log de erro com o erro capturado do executo

        oError_:Clear() // limpa o log de erro

    endif

Return .T.

/*/{Protheus.doc} fValidClasse
Valida se a Classe (Tipo) do Centro de Custo informada é válida (1 - Sintetico / 2 - Analitico).
@type function
@version 12.1.2410
@author TOTVS
@since 7/9/2025
@param aLinha, array, Linha de dados.
@return logical, Retorna .T. (true) para classe válida ou .F. (false) para classe inválida.
/*/
Static Function fValidClasse( aLinha as array ) as logical

Return( aLinha[ NPOS_CLASSE ] $ "1;2" )

/*/{Protheus.doc} fFormatCodigo
Função auxiliar para formatar o código do Centro de Custo, removendo caracteres especiais.
@type function
@version 12.1.2410
@author TOTVS
@since 7/8/2025
@param cCodigo, character, Codigo a ser formatado.
@return character, Codigo formatado.
/*/
Static Function fFormatCodigo( cCodigo as character ) as character

    cCodigo := allTrim(cCodigo)
    cCodigo := replace(cCodigo, '.', '')
    cCodigo := replace(cCodigo, '-', '')
    cCodigo := replace(cCodigo, '/', '')
    cCodigo := replace(cCodigo, '\', '')

Return cCodigo

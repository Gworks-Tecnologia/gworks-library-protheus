#include "tlpp-core.th"

using namespace Gworks.Library.Classes
using namespace Gworks.Library.Utils

namespace Gworks.Library.Functions

Static aFields__ := JsonObject():New() as json
Static cProps__ :=  "X3_ARQUIVO;" +;
                    "X3_ORDEM;" +;
                    "X3_CAMPO;" +;
                    "X3_TIPO;" +;
                    "X3_TAMANHO;" +;
                    "X3_DECIMAL;" +;
                    "X3_TITULO;" +;
                    "X3_DESCRIC;" +;
                    "X3_PICTURE;" +;
                    "X3_NIVEL;" +;
                    "X3_CONTEXT;" +;
                    "X3_VISUAL;" +;
                    "X3_OBRIGAT;" as character

/*/{Protheus.doc} GwGetFieldStruct
Função para retornar a estrutura do dicionário de dados de um determinado campo.
@type function
@version 12.1.2210
@author Gworks - Giovani Soares
@since 26/02/2024
@history 16/03/2026, Gworks - Giovani Soares,
    Função refatorada, a função legada foi mantida no namespace "Gworks.Library.Legacy.Functions.ref01".
@param cField, character, Nome do campo do dicionário de dados a ser retornado.
@return variant, Retorno possíveis:
    1. se cProperty não for informado, retorna toda a estrutura em json conforme formato a seguir:
        {
            "X3_ARQUIVO": string,
            "X3_ORDEM": string,
            "X3_CAMPO": string,
            "X3_TIPO": string,
            "X3_TAMANHO": string,
            "X3_DECIMAL": string,
            "X3_TITULO": string,
            "X3_DESCRIC": string,
            "X3_PICTURE": string,
            "X3_NIVEL": string,
            "X3_CONTEXT": string,
            "X3_VISUAL": string,
            "X3_OBRIGAT": string
        }
    2. se cProperty for informado, apenas retorna o conteúdo referente a mesma.
/*/
User Function GwGetFieldStruct( cField as character, cProperty as character )

    Default cField := ""
    Default cProperty := ""

    Local xResult as variant

    Local aArea := GetArea() as array
    Local aAreaSX3 := ("SX3")->(GetArea()) as array

    Local lFull := empty(cProperty) as logical

    cField := upper(allTrim(cField))
    if empty(cField)
        UserException("GwGetFieldStruct - Invalid cField param...")
    endif

    cProperty := upper(allTrim(cProperty))
    if !lFull .and. !(cProperty $ cProps__)
        UserException("GwGetFieldStruct - Invalid cProperty param...")
    endif

    if( valType(aFields__[cField]) == "U" )

        if!(U_GwOpenDictionary("SX3","X3DIC"))
            UserException("GwGetFieldStruct - Failed to position the SX3 table in the data dictionary...")
        endif

        X3DIC->(dbSetOrder(2)) // X3_CAMPO
        if!(X3DIC->(msSeek(cField)))
            UserException("GwGetFieldStruct - Failed to position field" +' "'+ cField +'"...')
        endif

        aFields__[cField] := JsonObject():New()
        aFields__[cField]["X3_ARQUIVO"] := allTrim(X3DIC->&("X3_ARQUIVO"))
        aFields__[cField]["X3_ORDEM"] := allTrim(X3DIC->&("X3_ORDEM"))
        aFields__[cField]["X3_CAMPO"] := allTrim(X3DIC->&("X3_CAMPO"))
        aFields__[cField]["X3_TIPO"] := allTrim(X3DIC->&("X3_TIPO"))
        aFields__[cField]["X3_TAMANHO"] := allTrim(X3DIC->&("X3_TAMANHO"))
        aFields__[cField]["X3_DECIMAL"] := allTrim(X3DIC->&("X3_DECIMAL"))
        aFields__[cField]["X3_TITULO"] := allTrim(X3DIC->&("X3_TITULO"))
        aFields__[cField]["X3_DESCRIC"] := allTrim(X3DIC->&("X3_DESCRIC"))
        aFields__[cField]["X3_PICTURE"] := allTrim(X3DIC->&("X3_PICTURE"))
        aFields__[cField]["X3_NIVEL"] := allTrim(X3DIC->&("X3_NIVEL"))
        aFields__[cField]["X3_CONTEXT"] := allTrim(X3DIC->&("X3_CONTEXT"))
        aFields__[cField]["X3_VISUAL"] := allTrim(X3DIC->&("X3_VISUAL"))
        aFields__[cField]["X3_OBRIGAT"] := allTrim(X3DIC->&("X3_OBRIGAT"))

        X3DIC->(DbCloseArea())

    endif

    xResult := iif( lFull, aFields__[cField], aFields__[cField][cProperty] )

    RestArea(aAreaSX3)
    RestArea(aArea)

Return xResult

#include 'totvs.ch'
#include 'tlpp-core.th'
#include "topconn.ch"
#include "protheus.ch"

namespace Gworks.Library.Classes

/*/{Protheus.doc} GwApiQuery
    API REST generica de consulta SQL, escrita em TLPP nativo (@post/oRest).
    Recebe uma instrucao SELECT no corpo da requisicao, executa e devolve o
    resultado como um array de objetos JSON - um objeto por linha, com os
    nomes das colunas em MAIUSCULO.
    Roda por DOIS caminhos, decididos pelos parametros:
        - sem parametro....: modo REST. O SQL vem do corpo da requisicao e a
          resposta volta pelo oRest. E como a rota sempre funcionou.
        - com cQuery.......: chamada DIRETA de qualquer rotina AdvPL, sem
          passar pelo servidor REST. O resultado volta em jResult.
    @type Function
    @author Gwork - Eduardo Deroce
    @since 26/08/2026
    @version 1.1
    @param cQuery, character, Instrucao SELECT. Omitido (nil) na chamada REST,
           quando o SQL e lido do corpo da requisicao.
    @param jResult, json, RECEBE POR REFERENCIA o resultado -- os dados, ou
           {erro, msg} quando falha. Preenchido nos dois modos.
    @return logical, .T. quando a consulta e respondida com sucesso, .F.
            quando falha (HTTP 400 no modo REST).
    @obs Observacoes
        - Rota....: POST /gwquery/query
        - Entrada.: {"query": "<SQL>"}
        - Saida...: {"data": [ {"<COLUNA>": <valor>, ...}, ... ]}
        - Falha...: HTTP 400 com {"erro": true, "msg": "<descricao>"}
        - O oRest so existe dentro de uma requisicao REST. Na chamada direta
          ele NAO e instanciado, entao todo acesso a ele fica atras do modo --
          inclusive o de resposta, nao apenas o de leitura do corpo.
        - Fora de um ambiente ja preparado (Type("cEmpAnt") <> "C") a rotina
          abre a empresa/filial 01/0101 via RpcSetEnv e encerra no finally.
          Chamada de dentro de uma rotina que ja tem ambiente, nao reabre.
        - Para so transformar um SELECT em json, sem tratamento de ambiente
          nem de erro, use U_GWQTOJSON direto -- e o miolo desta rotina.
        - A formatacao dos valores por tipo de coluna e feita em U_GWQTOJSON.
        - Consumidor atual: relatorios HTML, via ProtheusBridge.query em
          Temp\Report\WebApp\relatorios\assets\preload\advpltojs.js.
    @sample
        // ---- chamada DIRETA, sem REST ----------------------------------
        Local lOk     as logical
        Local jResult as json

        lOk := U_GwApiQuery("SELECT A1_COD, A1_NOME FROM SA1010", @jResult)

        If lOk
            // jResult["data"] -> array de linhas
        Else
            ConOut(jResult["msg"])
        EndIf

        // ---- requisicao ------------------------------------------------
        // POST http://<host>:<porta>/rest/gwquery/query
        // Content-Type: application/json
        //
        // {
        //     "query": "SELECT A1_COD, A1_NOME, A1_LC FROM SA1010 WHERE D_E_L_E_T_ = ' '"
        // }

        // ---- resposta (HTTP 200) ---------------------------------------
        // {
        //     "data": [
        //         { "A1_COD": "000001", "A1_NOME": "CLIENTE TESTE", "A1_LC": 15000 },
        //         { "A1_COD": "000002", "A1_NOME": "OUTRO CLIENTE", "A1_LC": 0 }
        //     ]
        // }

        // ---- resposta de falha (HTTP 400) ------------------------------
        // {
        //     "erro": true,
        //     "msg": "Body vazio ou invalido - informe {'query': '<SQL>'}."
        // }

        // ---- consumo em JavaScript (relatorios HTML) -------------------
        // const resp = await fetch("/rest/gwquery/query", {
        //     method : "POST",
        //     headers: { "Content-Type": "application/json" },
        //     body   : JSON.stringify({ query: "SELECT A1_COD, A1_NOME FROM SA1010" })
        // });
        // const { data } = await resp.json();

        // ---- consumo em AdvPL/TLPP (FWRest) ----------------------------
        Local oClient as object
        Local oResult as json
        Local cQuery  as character

        cQuery := '{"query": "SELECT A1_COD, A1_NOME FROM SA1010"}'

        oClient := FWRest():New("http://<host>:<porta>/rest")
        oClient:SetPath("/gwquery/query")
        oClient:SetPostParams(cQuery)

        if oClient:Post({"Content-Type: application/json"})
            oResult := JsonObject():New()
            oResult:FromJson(oClient:GetResult())
            // oResult["data"] -> array de linhas
        endif
/*/
@post('/gwquery/query')
User Function GwApiQuery(cQuery as Character, jResult as Json) as Logical

    Local err      as Object
    Local lRpc     as Logical
    Local lRet     as Logical
    Local lApi     as Logical
    Local cBody    as Character
    Local oBody    as Json
    Local oResp    as Json
    Local cSql     as Character

    lRet := .T.

    // DUAS ORIGENS, UMA ROTINA. Sem cQuery a chamada veio da rota REST: o SQL
    // sai do corpo da requisicao e a resposta volta pelo oRest. Com cQuery a
    // chamada e direta (Apps, job, outra rotina) e NAO EXISTE oRest -- ele so
    // e instanciado pelo servidor REST, entao tocar nele fora da rota derruba
    // a thread. Por isso todo acesso ao oRest esta atras deste lApi, e nao
    // apenas o de entrada.
    lApi := (ValType(cQuery) <> "C")

    try

        If Type("cEmpAnt") <> "C"
            RpcSetEnv("01", "0101")
            lRpc := .T.
        EndIf

        If lApi

            cBody := oRest:getBodyRequest()
            oBody := JsonObject():New()

            If Empty(cBody) .Or. ValType(oBody:FromJson(cBody)) == "C" .Or. Empty(oBody["query"])
                err := ErrorClass():New()
                err:description := "Body vazio ou invalido - informe {'query': '<SQL>'}."
                Throw err
            EndIf

            cSql := oBody["query"]

        Else

            cSql := AllTrim(cQuery)

            If Empty(cSql)
                err := ErrorClass():New()
                err:description := "Parametro cQuery vazio - informe a instrucao SELECT."
                Throw err
            EndIf

        EndIf

        oResp := U_GWQTOJSON(cSql)

        If lApi
            oRest:setResponse(EncodeUTF8(oResp:ToJson()))
        EndIf

    catch err

        oResp := JsonObject():New()
        oResp["erro"] := .T.
        If !Empty(err:description)
            oResp["msg"] := AllTrim(err:description)
        Else
            oResp["msg"] := "Erro desconhecido"
        EndIf

        If lApi
            oRest:setStatusCode(400)
            oRest:setFault(EncodeUTF8(oResp:ToJson()))
        EndIf

        lRet := .F.

    finally

        If lRpc
            RpcClearEnv()
        EndIf

        // No finally de proposito: na chamada direta quem falhou tambem precisa
        // do motivo, e o Logical sozinho nao carrega. Assim jResult chega
        // preenchido nos dois caminhos -- com os dados ou com {erro, msg}.
        jResult := oResp

    endtry

Return lRet

/*/{Protheus.doc} U_GWQUPD
    API REST generica de escrita (INSERT/UPDATE/DELETE) via TcSqlExec.
    Contrapartida de escrita da rota de consulta GwApiQuery. Nao e utilizada
    pelos relatorios HTML, que consomem apenas a consulta.
    Roda por dois caminhos, iguais aos da GwApiQuery: sem parametro le o SQL
    do corpo da requisicao REST; com cQuery e chamada direta de AdvPL.
    @type Function
    @author Gwork - Eduardo Deroce
    @since 26/08/2026
    @version 1.1
    @param cQuery, character, Comando INSERT/UPDATE/DELETE. Omitido (nil) na
           chamada REST, quando o SQL e lido do corpo da requisicao.
    @param jResult, json, RECEBE POR REFERENCIA o resultado. Preenchido nos
           dois modos.
    @return logical, .T. quando a requisicao e respondida com sucesso, .F.
            quando falha (HTTP 400 no modo REST).
    @obs Observacoes
        - Rota....: POST /gwquery/upd
        - Entrada.: {"query": "<SQL>"}
        - Saida...: {"query": "<SQL>", "erro": false, "msg": "sucesso"}
        - Falha...: HTTP 400 com {"erro": true, "msg": "<descricao>"} para
          erro de contrato; erro do banco retorna HTTP 200 com "erro": true
          e a mensagem de TCSQLError().
        - CUIDADO na chamada direta: erro do BANCO nao derruba o retorno. O
          TcSqlExec devolve status negativo e a rotina segue pelo caminho de
          sucesso, mantendo o contrato REST de HTTP 200 com "erro": true.
          Ou seja, .T. NAO quer dizer que gravou -- confira jResult["erro"].
        - O comando e enviado direto ao banco: nao passa por LogExec, gatilhos
          ou integridade do dicionario.
    @sample
        // ---- chamada DIRETA, sem REST ----------------------------------
        Local jResult as json

        U_GWQUPD("UPDATE SA1010 SET A1_LC = 0 WHERE A1_COD = '000001'", @jResult)

        If jResult["erro"]                 // e nao o retorno logico
            ConOut(jResult["msg"])
        EndIf

        // ---- requisicao ------------------------------------------------
        // POST http://<host>:<porta>/rest/gwquery/upd
        // Content-Type: application/json
        //
        // {
        //     "query": "UPDATE SA1010 SET A1_LC = 0 WHERE A1_COD = '000001'"
        // }

        // ---- resposta (HTTP 200) ---------------------------------------
        // {
        //     "query": "UPDATE SA1010 SET A1_LC = 0 WHERE A1_COD = '000001'",
        //     "erro" : false,
        //     "msg"  : "sucesso"
        // }
/*/
    @post('/gwquery/upd')
Function U_GWQUPD(cQuery as Character, jResult as Json) as Logical

    Local err      as Object
    Local lRpc     as Logical
    Local lRet     as Logical
    Local lApi     as Logical
    Local cBody    as Character
    Local oBody    as Json
    Local oResp    as Json
    Local cSql     as Character
    Local nStatus  as Numeric

    lRet := .T.

    // Mesma dupla origem da GwApiQuery -- ver o comentario la.
    lApi := (ValType(cQuery) <> "C")

    try

        If Type("cEmpAnt") <> "C"
            RpcSetEnv("01", "0101")
            lRpc := .T.
        EndIf

        If lApi

            cBody := oRest:getBodyRequest()
            oBody := JsonObject():New()

            If Empty(cBody) .Or. ValType(oBody:FromJson(cBody)) == "C" .Or. Empty(oBody["query"])
                err := ErrorClass():New()
                err:description := "Body vazio ou invalido - informe {'query': '<SQL>'}."
                Throw err
            EndIf

            cSql := oBody["query"]

        Else

            cSql := AllTrim(cQuery)

            If Empty(cSql)
                err := ErrorClass():New()
                err:description := "Parametro cQuery vazio - informe o comando SQL."
                Throw err
            EndIf

        EndIf

        nStatus := TcSqlExec(cSql)

        oResp          := JsonObject():New()
        oResp["query"] := cSql
        oResp["erro" ] := (nStatus < 0)
        If nStatus < 0
            oResp["msg"] := "TCSQLError() " + TCSQLError()
        Else
            oResp["msg"] := "sucesso"
        EndIf

        // ATENCAO na chamada direta: erro do BANCO nao chega aqui como excecao.
        // O TcSqlExec devolve status negativo e a rotina segue pelo caminho de
        // sucesso -- do lado REST isso vira HTTP 200 com "erro": true, que ja
        // era o contrato. Entao lRet .T. NAO significa que o comando gravou:
        // quem chama direto tem de olhar jResult["erro"].
        If lApi
            oRest:setResponse(EncodeUTF8(oResp:ToJson()))
        EndIf

    catch err

        oResp := JsonObject():New()
        oResp["erro"] := .T.
        If !Empty(err:description)
            oResp["msg"] := AllTrim(err:description)
        Else
            oResp["msg"] := "Erro desconhecido"
        EndIf

        If lApi
            oRest:setStatusCode(400)
            oRest:setFault(EncodeUTF8(oResp:ToJson()))
        EndIf

        lRet := .F.

    finally

        If lRpc
            RpcClearEnv()
        EndIf

        jResult := oResp

    endtry

Return lRet

/*/{Protheus.doc} GWQTOJSON
    Executa "cSql" via TCQUERY e devolve um Json no formato {"data": [...]},
    com um objeto por linha e as colunas em MAIUSCULO.
    Formatacao aplicada por tipo de coluna:
        - Data....: SET DATEFORMAT "dd/mm/yyyy" + StoD/cValToChar (string).
        - Numerico: valor repassado direto, sem conversao.
        - Texto...: AllTrim, removendo o preenchimento do campo.
    Publica (User Function, nao Static) para permitir reuso por outros pontos
    do sistema sem depender da rota REST GwApiQuery.
    @type Function
    @author Gwork - Eduardo Deroce
    @since 26/08/2026
    @version 1.0
    @param cSql, character, Instrucao SELECT a ser executada.
    @return json, Objeto {"data": [ {"<COLUNA>": <valor>, ...}, ... ]}. O
            array vem vazio quando a consulta nao retorna linhas.
    @obs Observacoes
        - A identificacao de data usa o dicionario (TamSX3), portanto so
          vale para colunas cujo nome exista no SX3; colunas calculadas ou
          com apelido fora do dicionario caem na regra de numerico/texto.
        - Colunas de tipo diferente de D/N/C nao entram no objeto da linha.
    @sample
        Local oJson as json

        oJson := U_GWQTOJSON("SELECT A1_COD, A1_NOME FROM SA1010 WHERE D_E_L_E_T_ = ' '")

        // oJson["data"][1]["A1_COD"]  -> "000001"
        // oJson["data"][1]["A1_NOME"] -> "CLIENTE TESTE"
/*/
User Function GWQTOJSON(cSql as Character) as Json

    Local aCampos    as Array
    Local nX         as Numeric
    Local oJson      as Json
    Local oLinha     as Json
    Local qGwQuery   as Character

    SET(_SET_DATEFORMAT, "dd/mm/yyyy")

    qGwQuery := ""
    TCQUERY cSql New Alias qGwQuery

    aCampos := qGwQuery->(DbStruct())

    oJson := JsonObject():New()
    oJson["data"] := {}

    While qGwQuery->(!Eof())

        oLinha := JsonObject():New()

        For nX := 1 To Len(aCampos)

            If FieldPos(aCampos[nX][1]) > 0 .And. Len(TamSX3(aCampos[nX][1])) > 0 .And. TamSX3(aCampos[nX][1])[3] == "D"
                oLinha[aCampos[nX][1]] := cValToChar(StoD(&("qGwQuery->" + aCampos[nX][1])))
            ElseIf aCampos[nX][2] == "N"
                oLinha[aCampos[nX][1]] := &("qGwQuery->" + aCampos[nX][1])
            ElseIf aCampos[nX][2] == "C"
                oLinha[aCampos[nX][1]] := AllTrim(&("qGwQuery->" + aCampos[nX][1]))
            EndIf

        Next nX

        Aadd(oJson["data"], oLinha)

        qGwQuery->(DbSkip())

    EndDo

    qGwQuery->(DbCloseArea())

Return oJson
